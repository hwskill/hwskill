{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hwskill.dev/schemas/catalog.schema.json",
    "title": "Catalog v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "source_commit",
        "entries"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "source_commit": {
            "type": [
                "string",
                "null"
            ]
        },
        "entries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/entry"
            }
        }
    },
    "$defs": {
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "entry",
                "entry_digest",
                "source_identity",
                "lifecycle",
                "install_capability",
                "verification_summary"
            ],
            "properties": {
                "entry": {
                    "$ref": "#/$defs/normalizedEntry"
                },
                "entry_digest": {
                    "type": "string",
                    "minLength": 1
                },
                "source_identity": {
                    "$ref": "#/$defs/sourceIdentity"
                },
                "lifecycle": {
                    "enum": [
                        "active",
                        "deprecated",
                        "withdrawn"
                    ]
                },
                "install_capability": {
                    "enum": [
                        "installable",
                        "guidance_only",
                        "temporarily_unavailable",
                        "disabled"
                    ]
                },
                "verification_summary": {
                    "$ref": "#/$defs/verificationSummary"
                }
            }
        },
        "normalizedEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "id",
                "name",
                "summary",
                "layer",
                "purposes",
                "examples",
                "source",
                "install",
                "compatibility",
                "license",
                "lifecycle"
            ],
            "properties": {
                "schema_version": {
                    "const": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "summary": {
                    "type": "string",
                    "minLength": 1
                },
                "layer": {
                    "enum": [
                        "l1",
                        "l2",
                        "l3",
                        "l4",
                        "l5"
                    ]
                },
                "purposes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "examples": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "prompt",
                            "expected_outcome"
                        ],
                        "properties": {
                            "prompt": {
                                "type": "string",
                                "minLength": 1
                            },
                            "expected_outcome": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "identity"
                    ],
                    "properties": {
                        "kind": {
                            "enum": [
                                "hosted",
                                "external"
                            ]
                        },
                        "identity": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "install": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "method",
                        "default_scope"
                    ],
                    "properties": {
                        "method": {
                            "enum": [
                                "directory",
                                "upstream",
                                "unknown"
                            ]
                        },
                        "default_scope": {
                            "const": "project"
                        },
                        "instructions_url": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "uri"
                        }
                    }
                },
                "compatibility": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "agents",
                        "systems",
                        "requirements"
                    ],
                    "properties": {
                        "agents": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "systems": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "requirements": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "license": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "status"
                    ],
                    "properties": {
                        "status": {
                            "enum": [
                                "known",
                                "unknown"
                            ]
                        },
                        "identifier": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string",
                            "format": "uri"
                        }
                    }
                },
                "lifecycle": {
                    "enum": [
                        "active",
                        "deprecated",
                        "withdrawn"
                    ]
                },
                "lifecycle_reason": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
        "replacement_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
            }
        },
        "sourceIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "identity"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "hosted",
                        "external"
                    ]
                },
                "identity": {
                    "type": "string",
                    "minLength": 1
                },
                "requested_ref": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "resolved_revision": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "content_digest": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "verificationSummary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "metadata",
                "acquisition",
                "installation",
                "behavior"
            ],
            "properties": {
                "metadata": {
                    "$ref": "#/$defs/summaryStage"
                },
                "acquisition": {
                    "$ref": "#/$defs/summaryStage"
                },
                "installation": {
                    "$ref": "#/$defs/summaryStage"
                },
                "behavior": {
                    "$ref": "#/$defs/summaryStage"
                }
            }
        },
        "summaryStage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "result"
            ],
            "properties": {
                "result": {
                    "enum": [
                        "pass",
                        "fail",
                        "blocked",
                        "not_run",
                        "unknown"
                    ]
                },
                "report_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "executed_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time"
                }
            }
        }
    }
}
