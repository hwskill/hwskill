{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwskill.dev/schemas/catalog.schema.json",
  "title": "Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "entries"],
  "properties": {
    "schema_version": {"const": 2},
    "source_commit": {"type": ["string", "null"]},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "entry_digest", "lifecycle", "translation"],
      "properties": {
        "entry": {"$ref": "#/$defs/entry"},
        "entry_digest": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["active", "deprecated", "withdrawn"]},
        "translation": {"$ref": "#/$defs/translation"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "name", "summary", "layer", "purposes", "examples", "source", "install", "compatibility", "license", "lifecycle"],
      "properties": {
        "schema_version": {"const": 2},
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "layer": {"enum": ["l1", "l2", "l3", "l4", "l5"]},
        "purposes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "examples": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["prompt", "expected_outcome"], "properties": {"prompt": {"type": "string", "minLength": 1}, "expected_outcome": {"type": "string", "minLength": 1}}}},
        "source": {"type": "object"},
        "install": {"type": "object"},
        "compatibility": {"type": "object"},
        "license": {"type": "object"},
        "owner": {"type": "string", "minLength": 1},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "lifecycle": {"enum": ["active", "deprecated", "withdrawn"]},
        "lifecycle_reason": {"type": "string", "minLength": 1},
        "replacement_id": {"type": "string", "minLength": 1}
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_format", "body", "translated_at", "source_url"],
      "properties": {
        "body_format": {"const": "markdown"},
        "body": {"type": "string", "minLength": 1},
        "translated_at": {"type": "string", "format": "date"},
        "source_url": {"type": "string", "format": "uri"}
      }
    }
  }
}
