{
  "name": "hwskill-directory-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "prebuild": "PYTHONPATH=../src python3 -m hwskill.directory build --repo-root .. --out .generated/directory --json && npm run prepare-data",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "postbuild": "node scripts/check-build.mjs --pre-index",
    "index": "pagefind --site dist && node scripts/check-build.mjs && node scripts/evaluate-search.mjs",
    "predev": "npm run build && pagefind --site dist && node scripts/prepare-dev-search.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/public-sans": "5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "markdown-it": "15.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2"
  }
}
