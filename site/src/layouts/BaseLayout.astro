---
import "../styles/global.css";
import { sitePath } from "../lib/urls";
import ThemeToggle from "../components/ThemeToggle.astro";
import themeInit from "../lib/theme-init.js?raw";

interface Props {
  title: string;
  description?: string;
  searchable?: boolean;
  searchKind?: "skill" | "recommendation";
}

const navigation = [
  { path: "/skills/", label: "技能目录" },
  { path: "/recommendations/", label: "技能推荐" },
  { path: "/contribute/", label: "我要推荐" },
];
const { title, description = "跨项目技能目录：按用途发现、了解并交给 Agent 安装。", searchable = false, searchKind } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline set:html={themeInit} />
    <meta name="description" content={description} />
    <meta name="hwskill:catalog" content={new URL(sitePath("/data/catalog.json"), Astro.site).href} />
    <title>{title} · HWSkill</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href={sitePath("/")} aria-label="HWSkill 首页"><span>HW</span>Skill</a>
      <div class="header-actions"><nav aria-label="主导航">
        {navigation.map(({ path, label }) => <a href={sitePath(path)} aria-current={Astro.url.pathname.startsWith(sitePath(path)) ? "page" : undefined}>{label}</a>)}
      </nav><ThemeToggle /></div>
    </header>
    <main id="main" data-pagefind-body={searchable ? "" : undefined}>
      {searchKind && <span hidden data-pagefind-meta="kind">{searchKind}</span>}
      <slot />
    </main>
    <footer data-pagefind-ignore>
      <p>目录随源码提交发布；外部来源、声明引用与兼容信息以条目为准。</p>
      <a href={sitePath("/contribute/")}>修正条目</a>
    </footer>
  </body>
</html>
