---
import "../styles/global.css";
import { sitePath } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
  searchable?: boolean;
}

const { title, description = "跨项目技能目录：按用途发现、核验并交给 Agent 安装。", searchable = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · HWSkill</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href={sitePath("/")} aria-label="HWSkill 首页"><span>HW</span>Skill</a>
      <nav aria-label="主导航">
        <a href={sitePath("/skills/")}>找技能</a>
        <a href={sitePath("/recommendations/")}>技能推荐</a>
        <a href={sitePath("/contribute/")}>贡献</a>
        <a href={sitePath("/data/catalog.json")}>机器目录</a>
      </nav>
    </header>
    <main id="main" data-pagefind-body={searchable ? "" : undefined}>
      <slot />
    </main>
    <footer data-pagefind-ignore>
      <p>目录随源码提交发布；外部来源另列版本核验状态。“兼容”不等于“已验证”。</p>
      <a href={sitePath("/contribute/")}>修正条目</a>
    </footer>
  </body>
</html>
