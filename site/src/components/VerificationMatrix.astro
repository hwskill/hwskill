---
import type { CatalogItem } from "../lib/data";
interface Props { summary: CatalogItem["verification_summary"] }
const { summary } = Astro.props;
const labels: Record<string, string> = { metadata: "元数据", acquisition: "来源取得", installation: "安装", behavior: "行为" };
const results: Record<string, string> = { pass: "通过", fail: "失败", blocked: "受阻", not_run: "未运行", unknown: "未知" };
---
<div class="verification-matrix">
  {Object.entries(summary).map(([stage, value]) => (
    <div class={`verification-cell result-${value.result}`}>
      <span>{labels[stage] ?? stage}</span>
      <strong>{results[value.result] ?? value.result}</strong>
      {value.executed_at && <time datetime={value.executed_at}>{value.executed_at.slice(0, 10)}</time>}
    </div>
  ))}
</div>
