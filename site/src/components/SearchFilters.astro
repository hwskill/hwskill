---
import { Input } from "./ui/input";
import { NativeSelect, NativeSelectOption } from "./ui/native-select";
import { RiSearchLine } from "@remixicon/react";
import RecommendationCard from "./RecommendationCard.astro";
import { recommendations } from "../lib/data";
import { sitePath } from "../lib/urls";
interface Props { synonyms: Record<string, string[]> }
const { synonyms } = Astro.props;
const pagefindBase = import.meta.env.BASE_URL;
---
<section class="search-panel" data-pagefind-ignore data-synonyms={JSON.stringify(synonyms)} data-pagefind-base={pagefindBase}>
  <label class="search-field">
    <span><RiSearchLine size={16} aria-hidden="true" />你想让 Agent 做什么？</span>
    <Input id="skill-search" type="search" placeholder="例如：排查 Spark 性能、检视 PR、制作测试" autoComplete="off" />
  </label>
  <div class="filters" aria-label="技能筛选">
    <label>层级
      <NativeSelect id="layer-filter"><NativeSelectOption value="">全部</NativeSelectOption>{["l1", "l2", "l3", "l4", "l5"].map((v) => <NativeSelectOption value={v}>{v.toUpperCase()}</NativeSelectOption>)}</NativeSelect>
    </label>
    <label>来源
      <NativeSelect id="source-filter"><NativeSelectOption value="">全部</NativeSelectOption><NativeSelectOption value="hosted">本目录托管</NativeSelectOption><NativeSelectOption value="external">外部来源</NativeSelectOption></NativeSelect>
    </label>
    <label>Agent
      <NativeSelect id="agent-filter"><NativeSelectOption value="">全部</NativeSelectOption><NativeSelectOption value="codex">Codex</NativeSelectOption><NativeSelectOption value="claude-code">Claude Code</NativeSelectOption><NativeSelectOption value="cursor">Cursor</NativeSelectOption><NativeSelectOption value="gemini-cli">Gemini CLI</NativeSelectOption></NativeSelect>
    </label>
  </div>
  <p id="search-status" class="search-status" role="status">输入用途，或直接使用筛选浏览。</p>
</section>
<div id="search-results" class="card-grid search-results" hidden></div>
{recommendations.map(item => <template data-recommendation-path={sitePath(`/recommendations/${item.id}/`)}><RecommendationCard item={item} /></template>)}
<script>
  import { highlightSegments } from "../lib/highlight.mjs";
  import { comparePublication } from "../lib/publication-order.mjs";
  const panel = document.querySelector<HTMLElement>(".search-panel");
  const input = document.querySelector<HTMLInputElement>("#skill-search");
  const layer = document.querySelector<HTMLSelectElement>("#layer-filter");
  const source = document.querySelector<HTMLSelectElement>("#source-filter");
  const agent = document.querySelector<HTMLSelectElement>("#agent-filter");
  const status = document.querySelector<HTMLElement>("#search-status");
  const results = document.querySelector<HTMLElement>("#search-results");
  const synonyms = JSON.parse(panel?.dataset.synonyms ?? "{}") as Record<string, string[]>;
  const MIN_RELATIVE_SCORE = 0.9;
  const MIN_ABSOLUTE_SCORE = 0.9;
  let latestRequest = 0;

  type SearchRecord = { url: string; meta: Record<string, string>; excerpt: string; score?: number };

  function recommendationCard(record: SearchRecord): HTMLElement | null {
    const pathname = new URL(record.url, window.location.origin).pathname;
    const template = [...document.querySelectorAll<HTMLTemplateElement>("template[data-recommendation-path]")]
      .find(item => item.dataset.recommendationPath === pathname);
    return template?.content.firstElementChild?.cloneNode(true) as HTMLElement ?? null;
  }

  function publicationOrder(left: SearchRecord, right: SearchRecord): number {
    return comparePublication(
      { id: left.meta["skill-id"] ?? left.url, publishedAt: left.meta["published-at"] },
      { id: right.meta["skill-id"] ?? right.url, publishedAt: right.meta["published-at"] },
    );
  }

  function highlightCard(card: HTMLElement, terms: string[]): number {
    let matches = 0;
    for (const selector of ["h3", "p", ".chip-list"]) {
      const region = card.querySelector(selector);
      if (!region) continue;
      const walker = document.createTreeWalker(region, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      for (const node of nodes) {
        const segments = highlightSegments(node.textContent ?? "", terms);
        if (!segments.some((segment) => segment.match)) continue;
        const fragment = document.createDocumentFragment();
        for (const segment of segments) {
          if (segment.match) {
            const mark = document.createElement("mark");
            mark.textContent = segment.text;
            fragment.append(mark);
            matches++;
          } else fragment.append(document.createTextNode(segment.text));
        }
        node.replaceWith(fragment);
      }
    }
    return matches;
  }

  function queryVariants(value: string): string[] {
    const normalized = value.trim().toLowerCase();
    if (!normalized) return [];
    const synonymEntries = Object.entries(synonyms);
    const canonical = synonymEntries.find(([, values]) => values.some((item) => item.toLowerCase() === normalized))?.[0];
    if (canonical && normalized.length <= 3) return [canonical];
    const shortToken = normalized.split(/\s+/u).find((token) => token.length <= 3);
    const tokenCanonical = shortToken
      ? synonymEntries.find(([, values]) => values.some((item) => item.toLowerCase() === shortToken))?.[0]
      : undefined;
    if (tokenCanonical) return [tokenCanonical];
    return canonical ? [value, canonical] : [value];
  }

  async function search() {
    if (!input || !layer || !source || !agent || !status || !results) return;
    const requestId = ++latestRequest;
    const queries = queryVariants(input.value);
    const filters = Object.fromEntries(Object.entries({ layer: layer.value, source: source.value, agent: agent.value }).filter(([, value]) => value));
    if (queries.length === 0 && Object.keys(filters).length === 0) {
      results.replaceChildren();
      results.hidden = true;
      status.textContent = "输入用途，或直接使用筛选浏览。";
      document.querySelector<HTMLElement>("#all-skills")?.removeAttribute("hidden");
      return;
    }
    try {
      const pagefindPath = `${panel?.dataset.pagefindBase ?? "/"}pagefind/pagefind.js`;
      const pagefindUrl = new URL(pagefindPath, window.location.origin).href;
      const pagefind = await import(/* @vite-ignore */ pagefindUrl);
      await pagefind.options({ ranking: { termSimilarity: 0 } });
      const responses = queries.length
        ? await Promise.all(queries.map((query) => pagefind.search(query, { filters })))
        : [await pagefind.search(null, { filters })];
      const resultMap = new Map<string, { id: string; score: number; data: () => Promise<{ url: string; meta: Record<string, string>; excerpt: string }> }>();
      for (const response of responses) for (const result of response.results) {
        const prior = resultMap.get(result.id);
        if (!prior || result.score > prior.score) resultMap.set(result.id, result);
      }
      const ranked = [...resultMap.values()].sort((left, right) => right.score - left.score);
      const topScore = ranked[0]?.score ?? 0;
      const scoreFloor = Math.max(topScore * MIN_RELATIVE_SCORE, MIN_ABSOLUTE_SCORE);
      const candidates = queries.length ? ranked.filter((result) => result.score >= MIN_ABSOLUTE_SCORE).slice(0, 20) : ranked;
      const candidateRecords = await Promise.all(candidates.map(async (result) => ({ ...await result.data() as SearchRecord, score: result.score })));
      const qualifying = queries.length
        ? candidateRecords.filter((record) => (record.score ?? 0) >= scoreFloor)
        : candidateRecords;
      const requiredKinds = queries.length
        ? ["skill", "recommendation"].flatMap((kind) => {
            const record = candidateRecords.find((candidate) => candidate.meta.kind === kind);
            return record ? [record] : [];
          })
        : [];
      const rankedRecords = [...new Set([...qualifying, ...requiredKinds])]
        .sort((left, right) => (right.score ?? 0) - (left.score ?? 0));
      const records = queries.length ? rankedRecords.slice(0, 5) : rankedRecords;
      for (const required of requiredKinds) {
        if (records.includes(required)) continue;
        let replaceIndex = records.length - 1;
        while (replaceIndex >= 0 && requiredKinds.includes(records[replaceIndex])) replaceIndex--;
        if (replaceIndex >= 0) records[replaceIndex] = required;
      }
      // Relevance selects the candidate set; all displayed lists use publication order.
      records.sort(publicationOrder);
      if (requestId !== latestRequest) return;
      const terms = [input.value, ...queries].flatMap((query) => query.trim().split(/\s+/)).filter(Boolean);
      const cards = records.flatMap((record) => {
        if (record.meta.kind === "recommendation") {
          const card = recommendationCard(record);
          if (!card) return [];
          card.dataset.resultKind = "recommendation";
          highlightCard(card, terms);
          return [card];
        }
        if (record.meta.kind !== "skill") return [];
        const id = record.meta["skill-id"];
        const original = [...document.querySelectorAll<HTMLElement>("#all-skills [data-skill-id]")]
          .find((card) => card.dataset.skillId === id);
        if (!original) return [];
        const card = original.cloneNode(true) as HTMLElement;
        if (terms.length && highlightCard(card, terms) === 0) {
          const summary = card.querySelector<HTMLElement>("p");
          if (summary) summary.innerHTML = record.excerpt;
        }
        return [card];
      });
      results.replaceChildren(...cards);
      results.hidden = cards.length === 0;
      document.querySelector<HTMLElement>("#all-skills")?.setAttribute("hidden", "");
      status.textContent = cards.length ? `找到 ${cards.length} 项` : "没有匹配项。可换一个用途词或清除筛选。";
    } catch {
      if (requestId !== latestRequest) return;
      results.replaceChildren();
      results.hidden = true;
      status.textContent = "搜索索引暂不可用；下面仍可浏览完整目录。";
      document.querySelector<HTMLElement>("#all-skills")?.removeAttribute("hidden");
    }
  }
  [input, layer, source, agent].forEach((element) => element?.addEventListener("input", search));
</script>
