---
interface Props {
  id: string;
  label: string;
  value: string;
  rows?: number;
}
const { id, label, value, rows = 14 } = Astro.props;
---
<textarea id={id} readonly rows={rows}>{value}</textarea>
<div class="install-actions"><button type="button" data-copy-target={id}>{label}</button></div>
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => {
    if (button.dataset.copyReady === "true") return;
    button.dataset.copyReady = "true";
    button.addEventListener("click", async () => {
      const textarea = document.getElementById(button.dataset.copyTarget ?? "") as HTMLTextAreaElement | null;
      if (!textarea) return;
      try {
        await navigator.clipboard.writeText(textarea.value);
        button.textContent = "已复制";
      } catch {
        textarea.focus();
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length);
        button.textContent = "请手动复制所选文本";
      }
    });
  });
</script>
