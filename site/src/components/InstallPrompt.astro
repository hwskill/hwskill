---
import { Button } from "./ui/button";
import { Textarea } from "./ui/textarea";
import { sitePath } from "../lib/urls";

interface Props {
  targetId: string;
  skillIds: string[];
  batch?: boolean;
}

const { targetId, skillIds, batch = false } = Astro.props;
const urls = skillIds.map((id) => new URL(sitePath(`/data/skills/${id}/install.md`), Astro.site).href);
const label = batch ? "一键安装全部技能" : "复制安装提示词";
const prompt = batch
  ? `请将以下 ${urls.length} 项技能安装到当前项目，并逐项报告结果：\n${urls.map((url) => `- ${url}`).join("\n")}\n\n逐项读取安装说明，检查技能 ID、声明的来源、可选引用和完整文件。按照明确提供的项目级安装方法操作，不要覆盖同名技能。某项无法安装时记录原因。报告每项的实际命令、安装目标、取得的引用和安装结果。`
  : `请读取 ${urls[0]}，检查技能 ID、声明的来源、可选引用、完整文件和项目级安装说明。按照上游明确提供的方法安装并尝试使用该技能，不要覆盖同名技能；记录实际命令、安装目标、取得的引用、安装结果和使用结果。遇到失败时停止并说明原因，最终报告实际结果。`;
---
<div class="copy-install" data-pagefind-ignore>
  <Button type="button" data-copy-target={targetId}>{label}</Button>
  <p class="copy-install-hint" aria-live="polite" data-copy-status>
    {batch ? `复制 ${urls.length} 项技能的项目级安装提示词，交给 Agent 执行。` : "复制后交给 Agent，在当前项目安装。"}
  </p>
  {!batch && <a href={urls[0]}>查看安装说明</a>}
  <details>
    <summary>查看提示词</summary>
    <Textarea id={targetId} readOnly rows={5} defaultValue={prompt} aria-label="项目级安装提示词" />
  </details>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => {
    button.addEventListener("click", async () => {
      const textarea = document.getElementById(button.dataset.copyTarget ?? "");
      if (!(textarea instanceof HTMLTextAreaElement)) return;
      const status = button.parentElement?.querySelector("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(textarea.value);
        if (status) status.textContent = "已复制安装提示词，可粘贴给 Agent。";
      } catch {
        const details = textarea.closest("details");
        if (details) details.open = true;
        textarea.focus();
        textarea.select();
        if (status) status.textContent = "请手动复制所选提示词。";
      }
    });
  });
</script>
