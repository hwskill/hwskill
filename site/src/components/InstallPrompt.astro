---
interface Props { id: string; installCapability: string; lifecycleReason?: string | null }
import { sitePath } from "../lib/urls";
const { id, installCapability, lifecycleReason = null } = Astro.props;
const url = new URL(sitePath(`/data/skills/${id}/install.md`), Astro.site).href;
const prompt = installCapability === "guidance_only"
  ? `请读取 ${url}，核对技能 ID、来源、请求版本、完整文件与项目级安装方法。安装和行为尚未验证；若能从来源确认所需材料及方法，可继续安装，不要覆盖同名技能。无法确认时请停止并说明缺少哪些证据；完成后报告实际目标、版本和识别结果。`
  : `请读取 ${url}，核对技能 ID、来源版本和项目级目标后安装。不要覆盖同名技能；完成后报告实际目标、版本和识别结果。`;
---
{installCapability === "disabled" ? (
<section class="install-panel" data-pagefind-ignore>
  <div>
    <p class="eyebrow">安装已停用</p>
    <h2>已撤回：停止新安装</h2>
    <p>{lifecycleReason ?? "该技能当前已撤回；历史材料仅用于理解既有安装。"}</p>
  </div>
</section>
) : (
<section class="install-panel" data-pagefind-ignore>
  <div>
    <p class="eyebrow">交给 Agent</p>
    <h2>{installCapability === "guidance_only" ? "核对来源后自行安装" : "复制项目级安装提示"}</h2>
  </div>
  <textarea id={`install-${id.replaceAll("/", "-")}`} readonly rows="5">{prompt}</textarea>
  <div class="install-actions">
    <button type="button" data-copy-target={`install-${id.replaceAll("/", "-")}`}>复制提示词</button>
    <a href={url}>查看安装说明</a>
  </div>
</section>
)}
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((button) => {
    button.addEventListener("click", async () => {
      const textarea = document.getElementById(button.dataset.copyTarget ?? "") as HTMLTextAreaElement | null;
      if (!textarea) return;
      try {
        await navigator.clipboard.writeText(textarea.value);
        button.textContent = "已复制";
      } catch {
        textarea.focus();
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length);
        button.textContent = "请手动复制所选文本";
      }
    });
  });
</script>
