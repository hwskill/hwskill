---
import type { CatalogItem } from "../lib/data";
import { sourceRepository } from "../lib/data";
import { Card } from "./ui/card";
import { Badge } from "./ui/badge";
import { sitePath } from "../lib/urls";
import { publicationLabel } from "../lib/publication-order.mjs";

interface Props { item: CatalogItem; badgeUrl?: string | null }
const { item, badgeUrl = null } = Astro.props;
const { entry } = item;
const repository = sourceRepository(entry.source);
const sourceLabel = entry.source.kind === "hosted" ? "本目录托管" : "外部来源";
const date = publicationLabel(item.publishedAt);
---
<Card role="article" className="content-card skill-card" data-skill-card data-skill-id={entry.id} data-published-at={item.publishedAt ?? ""} data-layer={entry.layer} data-source={entry.source.kind} data-lifecycle={entry.lifecycle} data-agents={entry.compatibility.agents.join(" ")}>
  <div class="card-topline">
    <Badge variant="secondary" className={`layer ${entry.layer}`}>{entry.layer.toUpperCase()}</Badge>
    <span>{sourceLabel}</span>
    {entry.lifecycle !== "active" && <span>{entry.lifecycle === "deprecated" ? "已弃用" : "已撤回"}</span>}
  </div>
  <h3 class="card-title"><a href={sitePath(`/skills/${entry.id}/`)}>{entry.name}</a></h3>
  <p class="card-summary">{entry.summary}</p>
  <ul class="chip-list" aria-label="用途">
    {entry.purposes.slice(0, 3).map((purpose) => <li>{purpose}</li>)}
  </ul>
  <div class="card-footer">
    <div class="card-meta"><span>{entry.compatibility.agents.join(" · ")}</span>{date && <time datetime={item.publishedAt!}>收录于 {date}</time>}</div>
    {repository && <a href={repository} rel="noreferrer">来源</a>}
    {badgeUrl && <img class="stars-badge" src={badgeUrl} alt="上游仓库 Stars" loading="lazy" onerror="this.hidden=true" />}
  </div>
</Card>
