---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchFilters from "../../components/SearchFilters.astro";
import SkillCard from "../../components/SkillCard.astro";
import { curation, entries } from "../../lib/data";
---
<BaseLayout title="查找技能" description="按用途、层级、Agent 与来源查找带中文译文的技能。">
  <header class="page-heading"><p class="eyebrow">技能目录</p><h1>你今天要完成什么？</h1><p>搜索用途、工具名或任务描述；筛选不依赖关键词。</p></header>
  <SearchFilters synonyms={curation.synonyms ?? {}} />
  <section id="all-skills" class="section-block">
    <div class="section-heading"><h2>全部技能</h2><span>{entries.length} 项</span></div>
    <div class="card-grid">{entries.map((item) => <SkillCard item={item} />)}</div>
  </section>
</BaseLayout>
