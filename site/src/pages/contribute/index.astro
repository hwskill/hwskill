---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContributionForm from "../../components/ContributionForm.astro";
import { buildContributionUrls } from "../../lib/contribution-prompts";

const urls = buildContributionUrls(Astro.site!);
---
<BaseLayout title="我要推荐">
  <header class="page-heading">
    <p class="eyebrow">Agent 辅助贡献</p>
    <h1>我要推荐</h1>
    <p>提供技能来源即可申请收录；补充推荐理由与使用场景，可同时贡献推荐文案。复制给 Agent 后，它会协助补齐资料并创建 PR。</p>
  </header>
  <section class="contribute-grid">
    <article><span>01</span><h2>提供来源</h2><p>填写技能地址或本地路径，可选补充推荐内容。</p></article>
    <article><span>02</span><h2>Agent 预检并完成</h2><p>Agent 先确认能力和 GitHub 权限，再处理许可证、翻译、文件与验证。</p></article>
    <article><span>03</span><h2>创建并检查 PR</h2><p>Agent 推送变更、创建 PR、等待必要 CI，并返回实际 URL 和验证边界。</p></article>
  </section>
  <section class="install-panel">
    <div><p class="eyebrow">贡献表单</p><h2>收录与推荐</h2><p>支持公开技能、已收录技能和有权再分发的本地技能。名称、许可证与其他元数据由 Agent 核实。</p></div>
    <ContributionForm id="skill-contribution-form" kind="skill" urls={urls} />
  </section>
  <section class="section-block">
    <h2>进一步核对</h2>
    <div class="resource-links"><a href={urls.agentGuide}>完整 Agent 指引</a><a href={urls.contributionRules}>贡献规范</a><a href={urls.catalog}>当前技能目录</a><a href={urls.repository}>GitHub 仓库</a></div>
  </section>
</BaseLayout>
