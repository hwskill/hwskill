---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CopyPrompt from "../../components/CopyPrompt.astro";
import { buildContributionUrls, buildRecommendationPrompt, buildSkillPrompt } from "../../lib/contribution-prompts";

const urls = buildContributionUrls(Astro.site!);
const skillPrompt = buildSkillPrompt(urls);
const recommendationPrompt = buildRecommendationPrompt(urls);
---
<BaseLayout title="贡献技能与推荐文章">
  <header class="page-heading">
    <p class="eyebrow">Agent 辅助贡献</p>
    <h1>复制一个提示词，产出可审阅的 Pull Request</h1>
    <p>选择贡献类型，补充尖括号中的信息并交给 Agent。发送完整提示词即授权 Agent 为本次贡献创建分支、提交、推送和 PR；不授权合并。</p>
  </header>
  <section class="contribute-grid">
    <article><span>01</span><h2>复制提示词</h2><p>技能和推荐文章各有独立入口，提示词包含完整公开资料地址。</p></article>
    <article><span>02</span><h2>Agent 补齐文件</h2><p>Agent 检查现有目录；推荐涉及未收录技能时，在同一 PR 中补齐条目。</p></article>
    <article><span>03</span><h2>校验并创建 PR</h2><p>Agent 运行离线校验、审阅变更，在取得 GitHub 授权后提交并返回 PR URL。</p></article>
  </section>
  <section class="install-panel">
    <div><p class="eyebrow">入口一</p><h2>贡献技能</h2><p>适合提交公开外部技能或本仓托管技能。</p></div>
    <CopyPrompt id="skill-contribution-prompt" label="复制技能贡献提示词" value={skillPrompt} rows={14} />
  </section>
  <section class="install-panel">
    <div><p class="eyebrow">入口二</p><h2>贡献推荐文章</h2><p>可以引用多个技能；缺失技能会先作为同一贡献的一部分补齐。</p></div>
    <CopyPrompt id="recommendation-contribution-prompt" label="复制推荐文章提示词" value={recommendationPrompt} rows={19} />
  </section>
  <section class="section-block">
    <h2>进一步核对</h2>
    <div class="resource-links"><a href={urls.agentGuide}>完整 Agent 指引</a><a href={urls.contributionRules}>贡献规范</a><a href={urls.catalog}>当前技能目录</a><a href={urls.repository}>GitHub 仓库</a></div>
  </section>
</BaseLayout>
