---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SkillCard from "../../components/SkillCard.astro";
import { curation, recommendations, topicEntries } from "../../lib/data";
import RecommendationCard from "../../components/RecommendationCard.astro";

export function getStaticPaths() {
  return (curation.topics ?? []).map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}
interface Props { topic: { slug: string; title: string } }
const { topic } = Astro.props;
const matched = topicEntries(topic.slug);
const relatedRecommendations = recommendations.filter((item) => item.topics?.includes(topic.slug));
---
<BaseLayout title={`${topic.title}技能`}>
  <header class="page-heading"><p class="eyebrow">用途主题</p><h1>{topic.title}</h1><p>浏览与该主题相关的技能。</p></header>
  <section class="section-block"><div class="section-heading"><h2>相关技能</h2><span>{matched.length} 项</span></div>{matched.length ? <div class="card-grid">{matched.map((item) => <SkillCard item={item} />)}</div> : <p class="empty-state">当前没有匹配的公开技能。</p>}</section>
  {relatedRecommendations.length > 0 && <section class="section-block"><div class="section-heading"><h2>相关推荐</h2></div><div class="recommendation-cards">{relatedRecommendations.map((item) => <RecommendationCard item={item} />)}</div></section>}
</BaseLayout>
