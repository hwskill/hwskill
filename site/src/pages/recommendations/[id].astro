---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entries, recommendationData, recommendationSummary, type Recommendation } from "../../lib/data";
import { resolveRecommendationSkills } from "../../lib/recommendation-links.mjs";
import { renderMarkdown } from "../../lib/markdown.mjs";
import { sitePath } from "../../lib/urls";
import { newestFirst, publicationLabel } from "../../lib/publication-order.mjs";

export function getStaticPaths() {
  return recommendationData.recommendations
    .filter((item) => item.status !== "draft")
    .map((recommendation) => {
      resolveRecommendationSkills(recommendation, entries);
      const format = (recommendation as Recommendation & { body_format?: string }).body_format;
      if (recommendation.status !== "withdrawn" && format && format !== "markdown") {
        throw new Error(`Recommendation ${recommendation.id} has unsupported body_format: ${format}`);
      }
      return { params: { id: recommendation.id }, props: { recommendation } };
    });
}
interface Props { recommendation: Recommendation }
const { recommendation } = Astro.props;
const linked = resolveRecommendationSkills(recommendation, entries);
const grouped = [...Map.groupBy(linked, (item) => `${item.entry.id.split("/", 1)[0]}/${item.entry.layer}`)]
  .sort(([left], [right]) => left.localeCompare(right))
  .map(([key, items]) => ({ key, items: newestFirst(items) }));
const withdrawn = recommendation.status === "withdrawn";
const markdownBody = recommendation.body_format === "markdown" ? renderMarkdown(recommendation.body) : null;
---
<BaseLayout title={recommendation.title} description={recommendationSummary(recommendation)} searchable={!withdrawn} searchKind={withdrawn ? undefined : "recommendation"}>
  <article class="recommendation-detail">
    <header class="page-heading"><p class="eyebrow">{withdrawn ? "已撤回推荐" : "技能推荐"}</p><h1 data-pagefind-meta="title">{recommendation.title}</h1><p data-pagefind-meta="summary">{recommendation.summary ?? `由 ${recommendation.author} 推荐`}</p><div class="detail-meta"><span>由 {recommendation.author} 推荐</span>{recommendation.publishedAt && <time datetime={recommendation.publishedAt}>发布于 {publicationLabel(recommendation.publishedAt)}</time>}</div></header>
    {recommendation.publishedAt && <span hidden data-pagefind-meta="published-at">{recommendation.publishedAt}</span>}
    {withdrawn && <aside class="notice"><strong>此推荐已撤回，请勿继续采用。</strong><p>{recommendation.withdrawal_reason}</p></aside>}
    {markdownBody ? <div class="prose" set:html={markdownBody} /> : <div class="prose"><p>{recommendation.body}</p></div>}
    {!withdrawn && recommendation.evidence?.length && <section class="evidence-section"><h2>公开依据</h2><ul>{recommendation.evidence.map((evidence) => <li><a href={evidence.url} rel="noopener noreferrer">{evidence.description ?? evidence.url}</a></li>)}</ul></section>}
    <section class="section-block"><h2>关联技能</h2>{recommendation.status === "ready" ? <div class="skill-link-groups">{grouped.map((group) => <section><h3>{group.key}</h3><ul>{group.items.map((item) => <li><a href={sitePath(`/skills/${item.entry.id}/`)}><span>{item.entry.name}</span><code>{item.entry.id}</code></a></li>)}</ul></section>)}</div> : <ul>{recommendation.skills.map((skill) => <li>{skill.id}</li>)}</ul>}</section>
  </article>
</BaseLayout>
