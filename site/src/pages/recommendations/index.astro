---
import { buttonVariants } from "../../components/ui/button";
import { RiArrowRightLine } from "@remixicon/react";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { recommendations } from "../../lib/data";
import RecommendationCard from "../../components/RecommendationCard.astro";
import { buildContributionUrls } from "../../lib/contribution-prompts";
import { sitePath } from "../../lib/urls";

const urls = buildContributionUrls(Astro.site!);
---
<BaseLayout title="技能推荐" description="从完整工作流和具体场景理解技能组合，并用 Agent 提示词贡献新的 Markdown 推荐文章。">
  <header class="page-heading recommendation-heading">
    <h1>技能推荐</h1>
    <p>当前收录 {recommendations.length} 篇可发布推荐。文章由 Markdown 维护，明确适用场景、成本、组合边界和作者判断。</p>
  </header>
  <section class="section-block">
    <div class="section-heading"><h2>全部推荐</h2><span>按发布时间从新到旧 · {recommendations.length} 篇</span></div>
    <div class="recommendation-cards">
      {recommendations.map((item) => <RecommendationCard item={item} />)}
    </div>
  </section>
  <section class="recommendation-contribution">
    <div>
      <p class="eyebrow">贡献推荐</p>
      <h2>推荐技能</h2>
      <p>分享技能的适用场景、推荐理由与使用经验，Agent 可协助整理推荐文案。</p>
      <p><strong>未收录技能必须在同一个 Pull Request 中补齐</strong>，Agent 会同时准备技能元数据、中文翻译、许可证核验和验证报告。</p>
      <div class="resource-links">
        <a href={urls.agentGuide}>完整 Agent 指引</a>
        <a href={urls.recommendationSchema}>Recommendation Source Schema</a>
        <a href={urls.recommendationTemplate}>Markdown 推荐模板</a>
        <a href={urls.contributionRules}>贡献规范</a>
        <a href={urls.repository}>GitHub 仓库</a>
      </div>
    </div>
    <a class:list={[buttonVariants({ size: "lg" }), "primary-action"]} href={`${sitePath("/contribute/")}#recommendation`}>我要推荐 →</a>
  </section>
</BaseLayout>
