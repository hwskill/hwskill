{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwskill.dev/schemas/release.schema.json",
  "title": "Release v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "sequence",
    "source_commit",
    "publication_time",
    "committed_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "publication_time": {
      "type": "string",
      "format": "date-time"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "feed_id",
        "event_id",
        "sequence",
        "release_id",
        "type",
        "subject_id",
        "subject_revision",
        "skill_ids",
        "published_at",
        "page_url",
        "machine_url"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "feed_id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "skill.added",
            "skill.updated",
            "skill.withdrawn",
            "recommendation.published",
            "recommendation.withdrawn"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_revision": {
          "type": "string",
          "minLength": 1
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "page_url": {
          "type": "string",
          "format": "uri"
        },
        "machine_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
