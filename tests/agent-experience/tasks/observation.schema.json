{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwskill.dev/tests/agent-experience/observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "workflow", "tuning", "status", "observed_at", "checks", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "workflow": {"type": "string", "minLength": 1},
    "tuning": {"enum": ["baseline", "optimized", "holdout"]},
    "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "category", "status", "reason", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "category": {"enum": ["task_definition", "public_inputs", "file_scope", "schema", "directory_completeness", "repository_validation", "host_identity", "source_revision", "output_json", "isolation"]},
          "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "object"}
        }
      }
    },
    "metrics": {"$ref": "#/$defs/metrics"}
  },
  "$defs": {
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["attempts", "success_rate", "tool_calls", "human_interventions", "duration_ms", "token_usage"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "human_interventions": {"type": ["integer", "null"], "minimum": 0},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "token_usage": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
