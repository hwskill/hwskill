{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwskill.dev/tests/agent-experience/task.schema.json",
  "title": "Clean Luna evaluation task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "workflow", "tuning", "prompt", "public_inputs",
    "allowed_changes", "required_paths", "schema_checks", "directory_checks",
    "repository_validation", "host_expectation", "source_revision_checks", "json_outputs", "yaml_outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "workflow": {"enum": ["hosted_install", "external_install", "skill_contribution", "recommendation", "correction"]},
    "tuning": {"enum": ["baseline", "optimized", "holdout"]},
    "prompt": {"type": "string", "minLength": 1},
    "public_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safePath"}},
    "allowed_changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safePattern"}},
    "required_paths": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "kind"],
        "properties": {"path": {"$ref": "#/$defs/safePath"}, "kind": {"enum": ["file", "directory"]}}
      }
    },
    "schema_checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "schema"],
        "properties": {"path": {"$ref": "#/$defs/safePath"}, "schema": {"$ref": "#/$defs/safePath"}}
      }
    },
    "directory_checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["actual", "expected"],
        "properties": {"actual": {"$ref": "#/$defs/safePath"}, "expected": {"$ref": "#/$defs/safePath"}}
      }
    },
    "repository_validation": {"type": "boolean"},
    "host_expectation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["host", "model", "reasoning_effort"],
          "properties": {
            "host": {"const": "codex"},
            "model": {"const": "gpt-5.6-luna"},
            "reasoning_effort": {"const": "medium"}
          }
        }
      ]
    },
    "source_revision_checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["checkout", "install", "report"],
        "properties": {
          "checkout": {"$ref": "#/$defs/safePath"},
          "install": {"$ref": "#/$defs/safePath"},
          "report": {"$ref": "#/$defs/safePath"}
        }
      }
    },
    "json_outputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "required_values"],
        "properties": {
          "path": {"$ref": "#/$defs/safePath"},
          "required_values": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["pointer", "equals"],
              "properties": {"pointer": {"type": "string", "pattern": "^/"}, "equals": {}}
            }
          }
        }
      }
    },
    "yaml_outputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "required_values"],
        "properties": {
          "path": {"$ref": "#/$defs/safePath"},
          "required_values": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["pointer", "equals"],
              "properties": {"pointer": {"type": "string", "pattern": "^/"}, "equals": {}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "safePattern": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
